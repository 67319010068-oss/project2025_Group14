<?php
session_start();
require "db.php";  // ไฟล์เชื่อมต่อฐานข้อมูล

$product_id = (int)$_POST['product_id'];
$quantity   = (int)$_POST['quantity'];
$session_id = session_id();
$user_id    = $_SESSION['user_id'] ?? null;

// 1. ดึง stock จริง
$stmt = $conn->prepare("SELECT stock FROM products WHERE id=?");
$stmt->bind_param("i", $product_id);
$stmt->execute();
$stock = $stmt->get_result()->fetch_assoc()['stock'];

// ถ้า stock หมด
if($stock <= 0){
    echo json_encode(["status"=>"error","message"=>"สินค้าหมดแล้ว"]);
    exit;
}

// 2. ตรวจสินค้าในตะกร้า (session หรือ user)
if($user_id){
    $stmt = $conn->prepare("SELECT id, quantity FROM cart WHERE product_id=? AND user_id=?");
    $stmt->bind_param("ii", $product_id, $user_id);
} else {
    $stmt = $conn->prepare("SELECT id, quantity FROM cart WHERE product_id=? AND session_id=?");
    $stmt->bind_param("is", $product_id, $session_id);
}
$stmt->execute();
$result = $stmt->get_result();

// 3. ถ้ามีสินค้าแล้ว → เช็กว่าเพิ่มเกิน stock ไหม
if($result->num_rows > 0){
    $row = $result->fetch_assoc();
    $new_qty = $row['quantity'] + $quantity;

    if($new_qty > $stock){
        echo json_encode(["status"=>"error","message"=>"มีสินค้าในสต็อกเพียง $stock ชิ้น"]);
        exit;
    }

    $stmt_upd = $conn->prepare("UPDATE cart SET quantity=? WHERE id=?");
    $stmt_upd->bind_param("ii",$new_qty,$row['id']);
    $stmt_upd->execute();
} else {

    if($quantity > $stock){
        echo json_encode(["status"=>"error","message"=>"มีสินค้าในสต็อกเพียง $stock ชิ้น"]);
        exit;
    }

    if($user_id){
        $stmt_ins = $conn->prepare("INSERT INTO cart (product_id, quantity, user_id) VALUES (?,?,?)");
        $stmt_ins->bind_param("iii", $product_id, $quantity, $user_id);
    } else {
        $stmt_ins = $conn->prepare("INSERT INTO cart (product_id, quantity, session_id) VALUES (?,?,?)");
        $stmt_ins->bind_param("iis", $product_id, $quantity, $session_id);
    }
    $stmt_ins->execute();
}

echo json_encode(["status"=>"success","message"=>"เพิ่มสินค้าลงตะกร้าสำเร็จ"]);
